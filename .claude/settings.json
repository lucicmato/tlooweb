{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run format:check *)",
      "Bash(npm run build *)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(node .claude/hooks/guardrails-report.mjs *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run format:check *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run test *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npx prettier *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npm ci)",
      "PowerShell(npm ls *)",
      "PowerShell(npm view *)",
      "PowerShell(node .claude/hooks/guardrails-report.mjs *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm update *)",
      "Bash(npm up *)",
      "Bash(npm uninstall *)",
      "Bash(npm remove *)",
      "Bash(npm rm *)",
      "Bash(npm exec *)",
      "PowerShell(git push *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(npm update *)",
      "PowerShell(npm up *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm remove *)",
      "PowerShell(npm rm *)",
      "PowerShell(npm exec *)",
      "Edit(eslint.config.*)",
      "Edit(eslint-rules/**)",
      "Edit(.eslintrc*)",
      "Edit(tsconfig*.json)",
      "Edit(prettier.config.*)",
      "Edit(.prettierrc*)",
      "Edit(.prettierignore)",
      "Edit(.github/workflows/**)",
      "Edit(playwright.config.*)",
      "Edit(jest.config.*)",
      "Edit(vitest.config.*)",
      "Edit(next.config.*)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Bash(psql:*)",
      "Bash(npm run migrate down:*)",
      "Bash(npm run migrate -- down:*)",
      "PowerShell(psql *)",
      "PowerShell(npm run migrate down *)",
      "PowerShell(npm run migrate -- down *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(.npmrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Edit(package-lock.json)",
      "Edit(npm-shrinkwrap.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(yarn.lock)",
      "Edit(node_modules/**)",
      "Edit(.git/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f*)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(yarn install *)",
      "Bash(bun add *)",
      "Bash(bun install *)",
      "Bash(npm publish *)",
      "Bash(npm publish)",
      "PowerShell(pnpm install *)",
      "PowerShell(pnpm i *)",
      "PowerShell(pnpm add *)",
      "PowerShell(yarn add *)",
      "PowerShell(yarn install *)",
      "PowerShell(bun add *)",
      "PowerShell(bun install *)",
      "PowerShell(npm publish *)",
      "PowerShell(npm publish)",
      "Bash(npm rebuild *)",
      "Bash(npm rb *)",
      "PowerShell(npm rebuild *)",
      "PowerShell(npm rb *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/reinject-instructions.mjs"],
            "statusMessage": "Re-reading AGENTS.md after compaction"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/snapshot-session.mjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.mjs"],
            "timeout": 120,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.mjs"],
            "timeout": 1500,
            "statusMessage": "Running the project checks (typecheck, lint)"
          }
        ]
      }
    ]
  }
}
