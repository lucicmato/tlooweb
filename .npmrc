# npm supply-chain guardrails for a new project. Replaces the `pnpm-workspace.yaml` of the workshop (the workshop
# uses pnpm 12.5.1; this kit uses npm). Every key below is a documented npm config:
# https://docs.npmjs.com/cli/v11/using-npm/config
#
# Not every pnpm guardrail has an npm equivalent, see the table "pnpm (radionica) -> npm (korisnik)" in README.md.
#
# Placeholders to replace are marked with PLACEHOLDER.

# Prevent installation of packages newer than 7 days, to mitigate supply chain risks (a compromised or hallucinated
# fresh release is not installed). Unit is DAYS (pnpm's `minimumReleaseAge: 10080` is minutes = 7 days).
# Needs npm >= 11.10.0: the key was added in 11.10.0 (npm CHANGELOG "11.10.0 ... add min-release-age (#8965)"), npm 10.6.0
# silently ignores it. `npm config get min-release-age` is NOT a valid check: 10.6.0 prints 7 though the key is not
# applied, 11.10.0 prints null though it is applied (measured). Check `npm --version` (major.minor >= 11.10) and, if in
# doubt, try to install a release younger than 7 days (`npm install <pkg>@<new version> --dry-run` must fail with ETARGET).
# Exception for ONE install (the npm replacement for pnpm's `minimumReleaseAgeExclude`, which npm does not have):
#   npm install some-package@1.2.3 --min-release-age=0
min-release-age=7

# Save exact versions without ^ or ~ ranges (pnpm: `savePrefix: ''`)
save-exact=true

# Do not run install scripts (`preinstall`, `install`, `postinstall`) of dependencies. This is the replacement for
# pnpm's `strictDepBuilds` + `allowBuilds`: nothing runs unless a person decided so. The explicit allow-list is the
# script `npm run rebuild:trusted` in package.snippet.jsonc, which runs `npm rebuild` for the trusted packages only
# (measured in a sandbox with npm 10.6.0: with `ignore-scripts=true` the install script of a dependency did not run,
# and `npm rebuild <pkg> --ignore-scripts=false` ran it).
# npm documents an `allow-scripts` config as well, but its semantics are † NOT VERIFIED here, so the kit does not
# use it.
# Side effects: this also skips the scripts of YOUR OWN package on `npm install` (`prepare`, `postinstall`), so do
# not rely on them. `npm run <script>` itself still runs.
ignore-scripts=true
