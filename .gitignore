# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# guardrails
.eslintcache

# Playwright MCP server output (agents use it)
.playwright-mcp/

# Git worktrees: agents work in parallel checkouts. Claude Code creates them in `.claude/worktrees/`, `/.worktrees/` is
# the workshop's folder. A worktree is a nested checkout: without these lines `git add -A` in the main checkout commits
# it as a gitlink (a submodule entry without `.gitmodules`) and pushes an empty folder, and `prettier --check .`
# checks every worktree's copy of the project.
/.worktrees/
/.claude/worktrees/
/docs/
/content/